# Database
DATABASE_URL=postgresql://user:password@localhost:5432/blklight_api

# JWT - Access Token
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# JWT - Refresh Token
# The refresh token is an opaque random string stored in the sessions table,
# not a signed JWT, so it needs no secret of its own.
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_TTL=30d

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS
# Comma-separated allowlist of bare origins: write them without a trailing
# slash, path, query, fragment or credentials (e.g. http://localhost:3000).
# Each entry must equal new URL(entry).origin exactly; anything else fails the
# boot and prints the corrected value to use.
# "*" is rejected at boot: wildcard origins are invalid with cookie credentials.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Behind a reverse proxy: the proxy IPs/CIDRs (hop counts are rejected). Unset = no proxy.
# Without it, per-IP rate limits (login, register) are shared by all users.
# TRUST_PROXY=10.0.0.0/8

# Refresh cookie
# SameSite for the httpOnly refresh cookie: strict | lax | none.
# "none" requires HTTPS (secure is forced on) and only makes sense when the
# frontend and the API live on different sites.
COOKIE_SAMESITE=strict

# Auth
MAX_SESSIONS_PER_USER=5
# Window in seconds where an already-rotated refresh token still returns a new
# access token instead of revoking the whole session family. Only exists to
# absorb parallel requests racing on the same cookie; keep it small.
REFRESH_REUSE_GRACE_SECONDS=30

# Document write rate limits (per minute, keyed by authenticated user, IP fallback)
# Applied only to create and publish. The autosave PATCH keeps the global 100/min.
RATE_LIMIT_DOCS_CREATE_MAX=20
RATE_LIMIT_DOCS_PUBLISH_MAX=10

# Signatures (AES-256-GCM encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNATURE_ENCRYPTION_KEY=your-64-char-hex-key-32-bytes-here

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth - Google (https://console.cloud.google.com/applications/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirects
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
EMAIL_DAILY_LIMIT=50
EMAIL_VERIFY_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Feature Flags
# Email verification and password reset (requires: RESEND_API_KEY, EMAIL_FROM, FRONTEND_URL)
FEATURE_EMAIL=false
# GitHub and Google OAuth login (requires: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
FEATURE_OAUTH=false
# Persistent email queue processor - runs every 10 minutes (requires: FEATURE_EMAIL=true)
FEATURE_EMAIL_QUEUE=false
# Code execution sandbox for tutorial exercises. UNSAFE: node:vm does not isolate
# submitted code from the host process. Keep false until a real sandbox lands.
FEATURE_CODE_SANDBOX=false
# Semantic memory (pgvector + Gemini embeddings) - only indexes when GEMINI_API_KEY is set
FEATURE_MEMORY=true
GEMINI_API_KEY=

# Admin Bootstrap (optional - creates first admin account on seed)
# If both are set, an admin user is created on first seed run
ADMIN_EMAIL=
ADMIN_PASSWORD=
